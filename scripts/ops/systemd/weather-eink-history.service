[Unit]
Description=Weather E-Ink Board generation history dashboard
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__ROOT_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON_BIN__ __ROOT_DIR__/scripts/history/server.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
StandardOutput=append:__ROOT_DIR__/runtime/logs/history_server.log
StandardError=append:__ROOT_DIR__/runtime/logs/history_server.log

[Install]
WantedBy=multi-user.target
